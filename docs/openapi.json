{
  "openapi": "3.1.0",
  "info": {
    "title": "CircuLink API",
    "version": "0.2.0",
    "description": "The API behind the CircuLink resident app and the hub portal. All paths are under /api. Dates are Philippine time (UTC+8). Generated from server/scripts/api-catalog.js by npm run docs:api."
  },
  "servers": [
    {
      "url": "http://localhost:4000/api"
    }
  ],
  "tags": [
    {
      "name": "account",
      "description": "Sign-up, login, profile and privacy"
    },
    {
      "name": "reference",
      "description": "Hubs, categories, rule numbers, photos and notifications"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "account"
        ],
        "summary": "Is the API up, and can it reach the database?",
        "description": "No login needed. Error codes: 503 when the database is down.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/privacy": {
      "get": {
        "operationId": "getPrivacy",
        "tags": [
          "account"
        ],
        "summary": "The privacy notice in English or Filipino",
        "description": "No login needed.",
        "security": [],
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "postAuthRegister",
        "tags": [
          "account"
        ],
        "summary": "Create a resident account (one per email, phone and student ID; privacy notice must be accepted)",
        "description": "No login needed. Error codes: bad_name, bad_email, bad_password, bad_phone, bad_student_id, privacy_required, signup_failed, too_many_requests.",
        "security": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {},
                  "email": {},
                  "password": {},
                  "phone": {},
                  "student_id": {},
                  "language": {},
                  "accept_privacy": {}
                },
                "required": [
                  "name",
                  "email",
                  "password",
                  "phone",
                  "accept_privacy"
                ]
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "postAuthLogin",
        "tags": [
          "account"
        ],
        "summary": "Log in; returns a token and the user",
        "description": "No login needed. Error codes: 401 bad_login, suspended, 429 too_many_attempts, too_many_requests.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {},
                  "password": {}
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "account"
        ],
        "summary": "The logged-in account (with a renewed token once a day for residents)",
        "description": "Any logged-in account.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchMe",
        "tags": [
          "account"
        ],
        "summary": "Change name, phone or language",
        "description": "Any logged-in account. Error codes: bad_name, bad_phone, phone_taken.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {},
                  "phone": {},
                  "language": {}
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "postAuthLogout",
        "tags": [
          "account"
        ],
        "summary": "Log out: ends every session of this account",
        "description": "Any logged-in account.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me/password": {
      "post": {
        "operationId": "postMePassword",
        "tags": [
          "account"
        ],
        "summary": "Change the password (other sessions end; a new token is returned)",
        "description": "Any logged-in account. Error codes: wrong_password, bad_password.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "current": {},
                  "new_password": {}
                },
                "required": [
                  "current",
                  "new_password"
                ]
              }
            }
          }
        }
      }
    },
    "/me/privacy": {
      "post": {
        "operationId": "postMePrivacy",
        "tags": [
          "account"
        ],
        "summary": "Agree to the current privacy notice",
        "description": "Any logged-in account.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me/data": {
      "get": {
        "operationId": "getMeData",
        "tags": [
          "account"
        ],
        "summary": "Everything CircuLink holds about this person (\"My data\")",
        "description": "Any logged-in account.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/me/delete-request": {
      "post": {
        "operationId": "postMeDeleteRequest",
        "tags": [
          "account"
        ],
        "summary": "Ask for the account to be deleted",
        "description": "A logged-in resident.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {}
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMeDeleteRequest",
        "tags": [
          "account"
        ],
        "summary": "Take back a deletion request",
        "description": "Any logged-in account.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/uploads": {
      "post": {
        "operationId": "postUploads",
        "tags": [
          "reference"
        ],
        "summary": "Upload a public photo (JPG, PNG or WEBP, at most 5 MB); returns its url",
        "description": "Any logged-in account. Error codes: no_file, bad_file_type, file_too_large.",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        }
      }
    },
    "/hubs": {
      "get": {
        "operationId": "getHubs",
        "tags": [
          "reference"
        ],
        "summary": "Active drop-off hubs",
        "description": "No login needed.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/meta": {
      "get": {
        "operationId": "getMeta",
        "tags": [
          "reference"
        ],
        "summary": "Categories, hubs, outcomes, badge tiers and the rule numbers",
        "description": "Any logged-in account.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "operationId": "getNotifications",
        "tags": [
          "reference"
        ],
        "summary": "My notifications, newest first (paged)",
        "description": "Any logged-in account.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/read-all": {
      "post": {
        "operationId": "postNotificationsReadAll",
        "tags": [
          "reference"
        ],
        "summary": "Mark all my notifications read",
        "description": "Any logged-in account.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/{id}/read": {
      "post": {
        "operationId": "postNotificationsIdRead",
        "tags": [
          "reference"
        ],
        "summary": "Mark one notification read",
        "description": "Any logged-in account. Error codes: not_found.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
