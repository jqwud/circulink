{
  "openapi": "3.1.0",
  "info": {
    "title": "CircuLink API",
    "version": "0.3.0",
    "description": "The API behind the CircuLink resident app and the hub portal. All paths are under /api. Dates are Philippine time (UTC+8). Generated from server/scripts/api-catalog.js by npm run docs:api."
  },
  "servers": [
    {
      "url": "http://localhost:4000/api"
    }
  ],
  "tags": [
    {
      "name": "account",
      "description": "Sign-up, login, profile and privacy"
    },
    {
      "name": "reference",
      "description": "Hubs, categories, rule numbers, photos and notifications"
    },
    {
      "name": "dropoffs",
      "description": "Residents declare items and get a drop-off code"
    },
    {
      "name": "staff",
      "description": "Hub staff check codes in, then weigh and sort items (the only place points are created)"
    },
    {
      "name": "admin",
      "description": "Admins review flagged drop-offs"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "account"
        ],
        "summary": "Is the API up, and can it reach the database?",
        "description": "No login needed. Error codes: 503 when the database is down.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          },
          "4XX": {
            "description": "An error: { error, code }",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
